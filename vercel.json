{
  "version": 2,
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/oyun",
      "destination": "/oyun.html"
    }
  ],
  "headers": [
    {
      "source": "/oyun.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ]
}
